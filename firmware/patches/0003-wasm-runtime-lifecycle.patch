+/* Caller owns s_mutex. Preserve the reusable arena on every failure path. */
+static void release_slot(wasm_slot_t *slot)
+{
+    uint8_t *arena = slot->arena;
+    /* m3_LoadModule transfers ownership only after a successful load. */
+    if (slot->module && slot->module->runtime == NULL) {
+        m3_FreeModule(slot->module);
+    }
+    if (slot->runtime) m3_FreeRuntime(slot->runtime);
+    if (slot->binary && slot->binary != arena) free(slot->binary);
+    memset(slot, 0, sizeof(*slot));
+    slot->arena = arena;
+    slot->state = WASM_MODULE_EMPTY;
 }
 
