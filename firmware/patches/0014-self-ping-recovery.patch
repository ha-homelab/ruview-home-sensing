--- /dev/null
+++ b/main/home_csi_ping.c
@@ -0,0 +1,338 @@
+#include "sdkconfig.h"
+#if defined(CONFIG_HOME_RUNTIME_RECOVERY_V1) && CONFIG_HOME_RUNTIME_RECOVERY_V1
+#include "home_csi_ping.h"
+#include <limits.h>
+#include <string.h>
+#include "esp_event.h"
+#include "esp_log.h"
+#include "esp_netif.h"
+#include "esp_timer.h"
+#include "esp_wifi.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "lwip/ip_addr.h"
+#include "ping/ping_sock.h"
+
+#ifndef CONFIG_CSI_SELF_PING_HZ
+#define CONFIG_CSI_SELF_PING_HZ 50
+#endif
+#if CONFIG_CSI_SELF_PING_HZ < 10 || CONFIG_CSI_SELF_PING_HZ > 50
+#error "Self-ping rate must remain within 10-50 Hz"
+#endif
+
+#define POLL_MS 1000U
+#define PROGRESS_DEADLINE_MS 10000U
+#define STOP_DEADLINE_MS 3000U
+#define RETIRE_DELAY_MS 2000U
+static const char *TAG = "home_csi_ping";
+static portMUX_TYPE s_mux = portMUX_INITIALIZER_UNLOCKED;
+static csi_self_ping_status_t s_status;
+static esp_ping_handle_t s_handle;
+static bool s_end_seen, s_initializing;
+static uint64_t s_last_progress;
+static uint32_t s_successes, s_timeouts, s_ends, s_network_epoch;
+/* 0: no event observed yet; 1: GOT_IP; -1: lost/disconnected. */
+static int s_ip_event;
+static esp_event_handler_instance_t s_wifi_handler, s_ip_handler;
+/* These fields belong only to the supervisor (never to callbacks). */
+static csi_self_ping_status_t s_work;
+static uint32_t s_session_epoch, s_failure_streak;
+static uint64_t s_stop_deadline, s_stop_retry;
+static bool s_stop_requested, s_start_failed, s_delete_failed;
+
+static uint64_t now_ms(void) { return (uint64_t)esp_timer_get_time() / 1000U; }
+static void increment(uint32_t *value) { if (*value != UINT32_MAX) ++*value; }
+
+static void publish(void)
+{
+    portENTER_CRITICAL(&s_mux);
+    s_status = s_work;
+    portEXIT_CRITICAL(&s_mux);
+}
+
+void csi_self_ping_get_status(csi_self_ping_status_t *out)
+{
+    if (!out) return;
+    portENTER_CRITICAL(&s_mux);
+    *out = s_status;
+    out->successes = s_successes;
+    out->timeouts = s_timeouts;
+    out->ends = s_ends;
+    out->last_progress_ms = s_last_progress;
+    out->network_epoch = s_network_epoch;
+    portEXIT_CRITICAL(&s_mux);
+}
+
+static void ping_progress(esp_ping_handle_t handle, bool success)
+{
+    uint64_t now = now_ms();
+    portENTER_CRITICAL(&s_mux);
+    if (handle == s_handle && !s_end_seen) {
+        if (success) increment(&s_successes); else increment(&s_timeouts);
+        s_last_progress = now;
+    }
+    portEXIT_CRITICAL(&s_mux);
+}
+static void ping_success(esp_ping_handle_t handle, void *arg)
+{ (void)arg; ping_progress(handle, true); }
+static void ping_timeout(esp_ping_handle_t handle, void *arg)
+{ (void)arg; ping_progress(handle, false); }
+static void ping_end(esp_ping_handle_t handle, void *arg)
+{
+    (void)arg;
+    portENTER_CRITICAL(&s_mux);
+    if (handle == s_handle && !s_end_seen) {
+        increment(&s_ends);
+        s_end_seen = true;
+    }
+    /* Last operation involving our state; callback storage is static. */
+    portEXIT_CRITICAL(&s_mux);
+}
+
+static void network_event(void *arg, esp_event_base_t base, int32_t id, void *data)
+{
+    (void)arg; (void)data;
+    int valid;
+    if (base == WIFI_EVENT && id == WIFI_EVENT_STA_DISCONNECTED) valid = -1;
+    else if (base == IP_EVENT && id == IP_EVENT_STA_LOST_IP) valid = -1;
+    else if (base == IP_EVENT && id == IP_EVENT_STA_GOT_IP) valid = 1;
+    else return;
+    portENTER_CRITICAL(&s_mux);
+    /* Wrap is harmless: only equality over a single one-second poll is used. */
+    ++s_network_epoch;
+    s_ip_event = valid;
+    portEXIT_CRITICAL(&s_mux);
+}
+
+typedef struct { uint32_t local, gateway, epoch; bool ready; } network_t;
+static network_t network_snapshot(void)
+{
+    network_t result = {0};
+    int event;
+    portENTER_CRITICAL(&s_mux);
+    result.epoch = s_network_epoch;
+    event = s_ip_event;
+    portEXIT_CRITICAL(&s_mux);
+    esp_netif_t *sta = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    esp_netif_ip_info_t ip;
+    wifi_ap_record_t ap;
+    if (event != -1 && sta && esp_netif_is_netif_up(sta) &&
+        esp_wifi_sta_get_ap_info(&ap) == ESP_OK &&
+        esp_netif_get_ip_info(sta, &ip) == ESP_OK && ip.ip.addr && ip.gw.addr) {
+        result.local = ip.ip.addr;
+        result.gateway = ip.gw.addr;
+        result.ready = true;
+    }
+    portENTER_CRITICAL(&s_mux);
+    if (result.epoch != s_network_epoch) result.ready = false;
+    portEXIT_CRITICAL(&s_mux);
+    return result;
+}
+
+static uint64_t backoff(uint64_t now)
+{
+    uint32_t shift = s_failure_streak < 5 ? s_failure_streak : 5;
+    uint32_t seconds = 1U << shift;
+    if (seconds > 30) seconds = 30;
+    increment(&s_failure_streak);
+    return now + (uint64_t)seconds * 1000U;
+}
+
+static bool ended(uint64_t *progress)
+{
+    portENTER_CRITICAL(&s_mux);
+    bool value = s_end_seen;
+    *progress = s_last_progress;
+    portEXIT_CRITICAL(&s_mux);
+    return value;
+}
+
+static void retire(uint64_t now)
+{
+    /* IDF5.4 ping_sock.c: stop clears START; the task calls on_ping_end only
+     * after leaving its send/receive loop. Each handle receives exactly ONE
+     * start notification. After end, no further callback/send is possible.
+     * delete clears INIT; the SDK task later frees its own socket/storage.
+     * The delay below limits allocation churn; it is NOT a deletion proof.
+     * Without end acknowledgement we keep the handle and never replace it.
+     * Failed esp_ping_start has not sent its notification in the pinned SDK;
+     * stop still must succeed before that unstarted handle can be retired. */
+    esp_err_t error = esp_ping_delete_session(s_handle);
+    if (error != ESP_OK) {
+        increment(&s_work.delete_failures);
+        s_work.last_error = error;
+        s_work.state = CSI_PING_BLOCKED;
+        s_delete_failed = true; /* outcome uncertain: never reuse/delete again */
+        ESP_LOGW(TAG, "delete failed; recovery blocked (%ld)", (long)error);
+        return;
+    }
+    portENTER_CRITICAL(&s_mux);
+    s_handle = NULL;
+    s_end_seen = false;
+    portEXIT_CRITICAL(&s_mux);
+    s_work.target_ipv4 = s_work.local_ipv4 = 0;
+    s_work.state = CSI_PING_RETIRING;
+    uint64_t retry = backoff(now);
+    s_work.next_retry_ms = retry > now + RETIRE_DELAY_MS ? retry : now + RETIRE_DELAY_MS;
+    s_stop_requested = s_start_failed = false;
+}
+
+static void request_stop(uint64_t now)
+{
+    esp_err_t error = esp_ping_stop(s_handle);
+    s_work.last_error = error;
+    if (error == ESP_OK) {
+        s_stop_requested = true;
+        s_stop_deadline = now + STOP_DEADLINE_MS;
+    } else {
+        increment(&s_work.stop_failures);
+        s_stop_retry = backoff(now);
+        ESP_LOGW(TAG, "stop failed; retaining session (%ld)", (long)error);
+    }
+    s_work.state = CSI_PING_STOPPING;
+}
+
+static void tick(uint64_t now)
+{
+    network_t net = network_snapshot();
+    uint64_t progress;
+    bool complete = ended(&progress);
+    if (s_handle) {
+        if (s_delete_failed) { publish(); return; }
+        if (complete || (s_start_failed && s_stop_requested)) {
+            retire(now);
+        } else if (s_work.state == CSI_PING_STOPPING || s_work.state == CSI_PING_BLOCKED) {
+            if (!s_stop_requested && now >= s_stop_retry) request_stop(now);
+            if (s_stop_requested && now >= s_stop_deadline) {
+                if (s_work.state != CSI_PING_BLOCKED)
+                    ESP_LOGW(TAG, "stop acknowledgement overdue; retaining session");
+                s_work.state = CSI_PING_BLOCKED;
+            }
+        } else if (!net.ready || net.local != s_work.local_ipv4 ||
+                   net.gateway != s_work.target_ipv4 || net.epoch != s_session_epoch ||
+                   (now >= progress && now - progress >= PROGRESS_DEADLINE_MS)) {
+            if ((now >= progress && now - progress >= PROGRESS_DEADLINE_MS)) increment(&s_work.stalls);
+            request_stop(now);
+        } else if (now - s_work.session_started_ms >= PROGRESS_DEADLINE_MS) {
+            s_failure_streak = 0;
+        }
+        publish();
+        return;
+    }
+    if (!net.ready) { s_work.state = CSI_PING_WAIT_IP; publish(); return; }
+    if (now < s_work.next_retry_ms) { s_work.state = CSI_PING_BACKOFF; publish(); return; }
+
+    esp_ping_config_t config = ESP_PING_DEFAULT_CONFIG();
+    ip_addr_t target;
+    memset(&target, 0, sizeof(target));
+    char gateway[16];
+    esp_ip4_addr_t gateway_ip = { .addr = net.gateway };
+    esp_ip4addr_ntoa(&gateway_ip, gateway, sizeof(gateway));
+    if (!ipaddr_aton(gateway, &target)) {
+        s_work.last_error = ESP_ERR_INVALID_ARG;
+        s_work.next_retry_ms = backoff(now);
+        s_work.state = CSI_PING_BACKOFF;
+        publish();
+        return;
+    }
+    config.target_addr = target;
+    config.count = ESP_PING_COUNT_INFINITE;
+    config.interval_ms = 1000U / CONFIG_CSI_SELF_PING_HZ;
+    config.timeout_ms = 1000;
+    config.data_size = 1;
+    config.task_stack_size = 4096;
+    const esp_ping_callbacks_t callbacks = {
+        .cb_args = NULL, .on_ping_success = ping_success,
+        .on_ping_timeout = ping_timeout, .on_ping_end = ping_end,
+    };
+    esp_ping_handle_t handle = NULL;
+    increment(&s_work.attempts);
+    esp_err_t error = esp_ping_new_session(&config, &callbacks, &handle);
+    if (error != ESP_OK || !handle) {
+        increment(&s_work.create_failures);
+        s_work.last_error = error == ESP_OK ? ESP_FAIL : error;
+        s_work.next_retry_ms = backoff(now);
+        s_work.state = CSI_PING_BACKOFF;
+        publish();
+        return;
+    }
+    portENTER_CRITICAL(&s_mux);
+    s_handle = handle;
+    s_end_seen = false;
+    s_last_progress = now;
+    portEXIT_CRITICAL(&s_mux);
+    s_work.local_ipv4 = net.local;
+    s_work.target_ipv4 = net.gateway;
+    s_session_epoch = net.epoch;
+    network_t current = network_snapshot();
+    if (!current.ready || current.epoch != net.epoch || current.local != net.local ||
+        current.gateway != net.gateway) {
+        /* Never started: no callback/send exists; normal SDK cleanup is safe. */
+        retire(now);
+        publish();
+        return;
+    }
+    error = esp_ping_start(handle);
+    s_work.last_error = error;
+    if (error != ESP_OK) {
+        increment(&s_work.start_failures);
+        s_start_failed = true;
+        request_stop(now);
+    } else {
+        increment(&s_work.starts);
+        s_work.state = CSI_PING_RUNNING;
+        s_work.session_started_ms = now;
+        ESP_LOGI(TAG, "self-ping running at %u Hz", CONFIG_CSI_SELF_PING_HZ);
+    }
+    publish();
+}
+
+static void supervisor(void *arg)
+{
+    (void)arg;
+    for (;;) {
+        tick(now_ms());
+        vTaskDelay(pdMS_TO_TICKS(POLL_MS));
+    }
+}
+
+esp_err_t home_csi_ping_start(void)
+{
+    portENTER_CRITICAL(&s_mux);
+    bool duplicate = s_initializing || s_status.supervisor_started;
+    if (!duplicate) s_initializing = true;
+    portEXIT_CRITICAL(&s_mux);
+    if (duplicate) return ESP_OK;
+    esp_err_t error = esp_event_handler_instance_register(
+        WIFI_EVENT, WIFI_EVENT_STA_DISCONNECTED, network_event, NULL, &s_wifi_handler);
+    if (error == ESP_OK) {
+        error = esp_event_handler_instance_register(
+            IP_EVENT, ESP_EVENT_ANY_ID, network_event, NULL, &s_ip_handler);
+        if (error != ESP_OK) {
+            esp_event_handler_instance_unregister(WIFI_EVENT, WIFI_EVENT_STA_DISCONNECTED, s_wifi_handler);
+        }
+    }
+    if (error == ESP_OK) {
+        /* Publish before task creation so a running task cannot be overwritten. */
+        s_work.supervisor_started = true;
+        s_work.state = CSI_PING_WAIT_IP;
+        publish();
+        if (xTaskCreate(supervisor, "csi_self_ping", 4096, NULL, 1, NULL) != pdPASS) {
+            esp_event_handler_instance_unregister(WIFI_EVENT, WIFI_EVENT_STA_DISCONNECTED, s_wifi_handler);
+            esp_event_handler_instance_unregister(IP_EVENT, ESP_EVENT_ANY_ID, s_ip_handler);
+            error = ESP_ERR_NO_MEM;
+        }
+    }
+    if (error != ESP_OK) {
+        s_work.supervisor_started = false;
+        s_work.state = CSI_PING_INIT_FAILED;
+        s_work.last_error = error;
+        publish();
+        ESP_LOGW(TAG, "supervisor initialization failed (%ld)", (long)error);
+    }
+    portENTER_CRITICAL(&s_mux);
+    s_initializing = false;
+    portEXIT_CRITICAL(&s_mux);
+    return error;
+}
+#endif
--- /dev/null
+++ b/main/home_csi_ping.h
@@ -0,0 +1,32 @@
+#ifndef HOME_CSI_PING_H
+#define HOME_CSI_PING_H
+#include "sdkconfig.h"
+#if defined(CONFIG_HOME_RUNTIME_RECOVERY_V1) && CONFIG_HOME_RUNTIME_RECOVERY_V1
+#include <stdbool.h>
+#include <stdint.h>
+#include "esp_err.h"
+
+typedef enum {
+    CSI_PING_WAIT_IP, CSI_PING_BACKOFF, CSI_PING_RUNNING,
+    CSI_PING_STOPPING, CSI_PING_RETIRING, CSI_PING_BLOCKED,
+    CSI_PING_INIT_FAILED
+} csi_self_ping_state_t;
+
+typedef struct {
+    csi_self_ping_state_t state;
+    bool supervisor_started;
+    /* IPv4 values in network byte order. Zero means no current session. */
+    uint32_t target_ipv4, local_ipv4;
+    uint32_t attempts, starts, create_failures, start_failures;
+    uint32_t stop_failures, delete_failures, stalls;
+    uint32_t successes, timeouts, ends, network_epoch;
+    int32_t last_error;
+    uint64_t last_progress_ms, session_started_ms, next_retry_ms;
+} csi_self_ping_status_t;
+
+/* One bounded supervisor; repeated initialization cannot create another owner. */
+esp_err_t home_csi_ping_start(void);
+/* Read-only snapshot. Echo timeouts are progress, not proof of CSI failure. */
+void csi_self_ping_get_status(csi_self_ping_status_t *out);
+#endif
+#endif
