+    info->uptime_ms = (uint64_t)esp_timer_get_time() / 1000;
+    info->worker_stack_bytes = WASM_NATIVE_STACK_BYTES;
+    /* ESP-IDF reports bytes, not vanilla FreeRTOS StackType_t units. */
+    info->worker_stack_min_free_bytes = uxTaskGetStackHighWaterMark(s_worker_task);
+    info->internal_min_free_bytes = heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
