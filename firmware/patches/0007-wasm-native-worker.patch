+/* All interpreter work uses one native stack. The 8 KiB WASM value stack
+ * passed to m3_NewRuntime is a different allocation. A cold first frame in
+ * 0.8.8.4 exhausted the DSP task's 8 KiB native stack during lazy compilation. */
+#define WASM_NATIVE_STACK_BYTES (32 * 1024)
+#if CONFIG_FREERTOS_UNICORE
+#define WASM_WORKER_CORE 0
+#else
+#define WASM_WORKER_CORE 1
+#endif
+static QueueHandle_t s_worker_queue;
+static SemaphoreHandle_t s_worker_done;
+static TaskHandle_t s_worker_task;
+static atomic_bool s_worker_ready;
+
+typedef enum { WORK_ENV, WORK_LOAD, WORK_RELEASE, WORK_CALL, WORK_FRAME,
+               WORK_TIMER } wasm_work_op_t;
+typedef struct {
+    wasm_work_op_t op;
+    wasm_slot_t *slot;
+    IM3Function function;
+    int32_t n_sc;
+    uint32_t *execution_us;
+    M3Result result;
+} wasm_work_t;
+
+static void worker_run_timer(void);
+
+/* Caller owns s_mutex. Preserve the reusable arena on every failure path. */
+static void release_slot(wasm_slot_t *slot)
+{
+    uint8_t *arena = slot->arena;
+    /* m3_LoadModule transfers ownership only after a successful load. */
+    if (slot->module && slot->module->runtime == NULL) {
+        m3_FreeModule(slot->module);
+    }
+    if (slot->runtime) m3_FreeRuntime(slot->runtime);
+    if (slot->binary && slot->binary != arena) free(slot->binary);
+    memset(slot, 0, sizeof(*slot));
+    slot->arena = arena;
+    slot->state = WASM_MODULE_EMPTY;
+}
+
+
+static M3Result worker_load(wasm_slot_t *slot)
+{
+    slot->runtime = m3_NewRuntime(s_env, WASM_STACK_SIZE, NULL);
+    if (!slot->runtime) return m3Err_mallocFailed;
+    M3Result result = m3_ParseModule(s_env, &slot->module,
+                                     slot->binary, slot->binary_size);
+    if (!result) result = m3_LoadModule(slot->runtime, slot->module);
+    if (!result) result = link_host_api(slot->module);
+    /* Compile every function now, so a frame/timer never pays lazy compilation
+     * cost halfway through an interpreter call chain. Imports are linked first. */
+    if (!result) result = m3_CompileModule(slot->module);
+    if (result) return result;
+    m3_FindFunction(&slot->fn_on_init, slot->runtime, "on_init");
+    m3_FindFunction(&slot->fn_on_frame, slot->runtime, "on_frame");
+    m3_FindFunction(&slot->fn_on_timer, slot->runtime, "on_timer");
+    return m3Err_none;
+}
+
+static void worker_main(void *arg)
+{
+    (void)arg;
+    for (;;) {
+        wasm_work_t *work = NULL;
+        if (xQueueReceive(s_worker_queue, &work, portMAX_DELAY) != pdTRUE) continue;
+        work->result = m3Err_none;
+        switch (work->op) {
+            case WORK_ENV: s_env = m3_NewEnvironment(); break;
+            case WORK_LOAD: work->result = worker_load(work->slot); break;
+            case WORK_RELEASE: release_slot(work->slot); break;
+            case WORK_CALL: work->result = m3_CallV(work->function); break;
+            case WORK_FRAME: {
+                int64_t started = esp_timer_get_time();
+                work->result = m3_CallV(work->function, work->n_sc);
+                *work->execution_us = (uint32_t)(esp_timer_get_time() - started);
+                break;
+            }
+            case WORK_TIMER: worker_run_timer(); break;
+        }
+        bool failed_init = work->op == WORK_ENV && s_env == NULL;
+        if (work->op != WORK_TIMER) xSemaphoreGive(s_worker_done);
+        /* Never touch the completed job, queue or semaphore after this point
+         * when initialization failed. The creator can release them immediately;
+         * self-deletion avoids deleting a running task on the other CPU. */
+        if (failed_init) vTaskDelete(NULL);
+    }
+}
+
+/* Boot is single-threaded; after boot the caller must own s_mutex. This keeps
+ * the borrowed slot/frame buffers alive until completion. Never time out this
+ * wait and return while the worker could still access the caller's buffers.
+ * A separate semaphore avoids consuming the DSP task's CSI notifications. */
+static M3Result worker_run(wasm_work_t work)
+{
+    wasm_work_t *job = &work;
+    xQueueSend(s_worker_queue, &job, portMAX_DELAY);
+    xSemaphoreTake(s_worker_done, portMAX_DELAY);
+    return work.result;
+}
