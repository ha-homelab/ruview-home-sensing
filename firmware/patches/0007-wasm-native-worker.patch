+void wasm_runtime_on_timer(void)
+{
+    /* One queued timer request at most; no interpreter or wait in esp_timer.
+     * Static lifetime also remains safe if a lifecycle operation is in flight.
+     * The worker tries s_mutex and drops this tick when another caller owns it. */
+    static wasm_work_t timer_work = {.op = WORK_TIMER};
+    wasm_work_t *job = &timer_work;
+    if (atomic_load(&s_worker_ready)) xQueueSend(s_worker_queue, &job, 0);
+}
