+/* ESP-IDF sends the response header, terminator and body separately. Disable
+ * Nagle on each accepted socket so a short status/identity response cannot
+ * wait behind the peer's delayed ACK. The HTTP server owns socket closure. */
+static esp_err_t ota_http_open(httpd_handle_t server, int socket_fd)
+{
+    (void)server;
+    const int enabled = 1;
+    if (socket_fd < 0 || setsockopt(socket_fd, IPPROTO_TCP, TCP_NODELAY,
+                                  &enabled, sizeof(enabled)) != 0) {
+        ESP_LOGW(TAG, "Cannot disable Nagle for HTTP session");
+        return ESP_FAIL;
+    }
+    return ESP_OK;
+}
