+static const char *self_ping_state_name(csi_self_ping_state_t state)
+{
+    switch (state) {
+    case CSI_PING_WAIT_IP: return "wait_ip";
+    case CSI_PING_BACKOFF: return "backoff";
+    case CSI_PING_RUNNING: return "running";
+    case CSI_PING_STOPPING: return "stopping";
+    case CSI_PING_RETIRING: return "retiring";
+    case CSI_PING_BLOCKED: return "blocked";
+    case CSI_PING_INIT_FAILED: return "init_failed";
+    default: return "unknown";
+    }
+}
+
+static bool append_self_ping_json(char *buffer, size_t capacity, size_t *used)
+{
+    csi_self_ping_status_t ping;
+    csi_self_ping_get_status(&ping);
+    int64_t observed_us = esp_timer_get_time();
+    uint64_t observed_ms = observed_us >= 0 ? (uint64_t)observed_us / 1000U : 0;
+    char age[24] = "null";
+    /* This watchdog anchor is set at session creation and on either success
+     * OR timeout. It is not a CSI observation or proof of an echo reply.
+     * Retired sessions retain the anchor: interpret it together with state.
+     * Same boot uint64 time only; unavailable/future anchors remain null. */
+    if (observed_us >= 0 && ping.last_progress_ms != 0 &&
+        observed_ms >= ping.last_progress_ms) {
+        snprintf(age, sizeof(age), "%llu",
+                 (unsigned long long)(observed_ms - ping.last_progress_ms));
+    }
+    return append_json(buffer, capacity, used,
+        ",\"self_ping\":{\"state\":\"%s\",\"supervisor_started\":%s,"
+        "\"attempts\":%lu,\"starts\":%lu,\"create_failures\":%lu,\"start_failures\":%lu,"
+        "\"stop_failures\":%lu,\"delete_failures\":%lu,\"stalls\":%lu,"
+        "\"successes\":%lu,\"timeouts\":%lu,\"ends\":%lu,\"network_epoch\":%lu,"
+        "\"last_error\":%ld,\"last_progress_age_ms\":%s,"
+        "\"last_progress_age_basis\":\"session_start_or_ping_callback\"}",
+        self_ping_state_name(ping.state), ping.supervisor_started ? "true" : "false",
+        (unsigned long)ping.attempts, (unsigned long)ping.starts,
+        (unsigned long)ping.create_failures, (unsigned long)ping.start_failures,
+        (unsigned long)ping.stop_failures, (unsigned long)ping.delete_failures,
+        (unsigned long)ping.stalls, (unsigned long)ping.successes,
+        (unsigned long)ping.timeouts, (unsigned long)ping.ends,
+        (unsigned long)ping.network_epoch, (long)ping.last_error, age);
+}
