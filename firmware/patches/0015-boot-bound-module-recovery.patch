+/* Initialized once on main's post-Wi-Fi-connect path, before httpd_start.
+ * RF is enabled at that point, providing entropy to esp_fill_random (IDF5.4).
+ * Do not regenerate when an HTTP server is restarted during the same boot.
+ * No NVS writes; the PSK and the boot identity have independent lifetimes. */
+static bool s_boot_identity_attempted;
+static esp_err_t s_boot_identity_error = ESP_ERR_INVALID_STATE;
+static char s_boot_nonce[OTA_BOOT_NONCE_HEX_LENGTH + 1];
+static char s_boot_station_mac[18];
+static esp_timer_handle_t s_restart_timer;
+static bool s_restart_pending;
+
+static esp_err_t ota_boot_identity_init(void)
+{
+    if (s_boot_identity_attempted) return s_boot_identity_error;
+    s_boot_identity_attempted = true;
+    uint8_t mac[6] = {0};
+    esp_err_t error = esp_wifi_get_mac(WIFI_IF_STA, mac);
+    if (error != ESP_OK) {
+        s_boot_identity_error = error;
+        return error;
+    }
+    uint8_t any_mac = 0;
+    for (size_t i = 0; i < sizeof(mac); ++i) any_mac |= mac[i];
+    if (!any_mac || (mac[0] & 1U)) return s_boot_identity_error;
+
+    uint8_t random_bytes[16];
+    esp_fill_random(random_bytes, sizeof(random_bytes));
+    uint8_t any_random = 0;
+    for (size_t i = 0; i < sizeof(random_bytes); ++i) any_random |= random_bytes[i];
+    if (!any_random) return s_boot_identity_error;  /* no zero/fixed fallback */
+    static const char hex[] = "0123456789abcdef";
+    for (size_t i = 0; i < sizeof(random_bytes); ++i) {
+        s_boot_nonce[2 * i] = hex[random_bytes[i] >> 4];
+        s_boot_nonce[2 * i + 1] = hex[random_bytes[i] & 15U];
+    }
+    s_boot_nonce[OTA_BOOT_NONCE_HEX_LENGTH] = '\0';
+    snprintf(s_boot_station_mac, sizeof(s_boot_station_mac),
+             "%02x:%02x:%02x:%02x:%02x:%02x", mac[0], mac[1], mac[2],
+             mac[3], mac[4], mac[5]);
+    s_boot_identity_error = ESP_OK;
+    return ESP_OK;
+}
+
+const char *ota_boot_nonce(void)
+{
+    return s_boot_identity_error == ESP_OK ? s_boot_nonce : NULL;
+}
+
+const char *ota_boot_station_mac(void)
+{
+    return s_boot_identity_error == ESP_OK ? s_boot_station_mac : NULL;
+}
+
+esp_err_t ota_boot_require(httpd_req_t *req)
+{
+    char expected[OTA_BOOT_NONCE_HEX_LENGTH + 1] = {0};
+    bool matches = ota_boot_nonce() != NULL &&
+        httpd_req_get_hdr_value_len(req, OTA_BOOT_NONCE_HEADER) == OTA_BOOT_NONCE_HEX_LENGTH &&
+        httpd_req_get_hdr_value_str(req, OTA_BOOT_NONCE_HEADER, expected, sizeof(expected)) == ESP_OK;
+    volatile uint8_t difference = 0;
+    if (matches) {
+        for (size_t i = 0; i < OTA_BOOT_NONCE_HEX_LENGTH; ++i)
+            difference |= (uint8_t)(expected[i] ^ s_boot_nonce[i]);
+        matches = difference == 0;
+    }
+    if (matches) return ESP_OK;
+    httpd_resp_set_status(req, "409 Conflict");
+    httpd_resp_set_type(req, "application/json");
+    httpd_resp_send(req, "{\"error\":\"boot_nonce_mismatch\"}", HTTPD_RESP_USE_STRLEN);
+    return ESP_FAIL;  /* close session without receiving any stale body */
+}
+
+#endif /* CONFIG_HOME_RUNTIME_RECOVERY_V1 */
 
