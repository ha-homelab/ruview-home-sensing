+#if defined(CONFIG_HOME_RUNTIME_RECOVERY_V1) && CONFIG_HOME_RUNTIME_RECOVERY_V1
+/* Authenticated, boot-bound, body-free recovery. Scheduling is explicit: a
+ * successful response means a timer was armed, not that a new boot was observed.
+ * The one-second timer is independent of HTTP send completion/failure. Actual
+ * callback dispatch remains subject to scheduling; this is not a real-time SLA.
+ * The caller must GET the new nonce afterwards; it must never retry blindly. */
+static void ota_restart_callback(void *unused)
+{
+    (void)unused;
+    esp_restart();
+}
+
+static esp_err_t ota_restart_handler(httpd_req_t *req)
+{
+    if (!ota_check_auth(req)) {
+        httpd_resp_send_err(req, HTTPD_403_FORBIDDEN, "Authentication required");
+        return ESP_FAIL;
+    }
+    if (ota_boot_require(req) != ESP_OK) return ESP_FAIL;
+    if (req->content_len != 0) {
+        httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST, "Restart requires an empty body");
+        return ESP_FAIL;
+    }
+    if (s_restart_pending) {
+        httpd_resp_set_status(req, "409 Conflict");
+        httpd_resp_send(req, "Restart already scheduled", HTTPD_RESP_USE_STRLEN);
+        return ESP_FAIL;
+    }
+    if (s_restart_timer == NULL) {
+        const esp_timer_create_args_t args = {
+            .callback = ota_restart_callback, .arg = NULL,
+            .dispatch_method = ESP_TIMER_TASK, .name = "home_restart",
+        };
+        if (esp_timer_create(&args, &s_restart_timer) != ESP_OK) {
+            httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "Cannot create restart timer");
+            return ESP_FAIL;
+        }
+    }
+    if (esp_timer_start_once(s_restart_timer, 1000000ULL) != ESP_OK) {
+        httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "Cannot schedule restart");
+        return ESP_FAIL;
+    }
+    s_restart_pending = true;
+    char response[192];
+    int len = snprintf(response, sizeof(response),
+        "{\"restart_scheduled\":true,\"delay_ms\":1000,\"boot_nonce_schema\":\"%s\",\"boot_nonce\":\"%s\"}",
+        OTA_BOOT_NONCE_SCHEMA, ota_boot_nonce());
+    httpd_resp_set_type(req, "application/json");
+    return httpd_resp_send(req, response, len);
+}
+
+#endif /* CONFIG_HOME_RUNTIME_RECOVERY_V1 */
