+void hwp_core_init(hwp_core_t *s) { memset(s, 0, sizeof(*s)); }
+static void fallback_wait(hwp_core_t *s, uint64_t now) {
+    static const unsigned delays[] = {5000, 10000, 20000, 40000, 60000};
+    s->preferred = false;
+    s->phase = HWP_FALLBACK_WAIT;
+    s->next_at = now + delays[s->backoff];
+    if (s->backoff < 4) ++s->backoff;
+}
+static void cycle(hwp_core_t *s, uint64_t now) {
+    if (now >= s->next_preferred_at) {
+        s->preferred = true;
+        s->preferred_failures = 0;
+        s->preferred_deadline = now + HWP_PREFERRED_MS;
+        s->next_preferred_at = now + HWP_RETRY_COOLDOWN_MS;
+        s->next_at = now;
+        s->phase = HWP_PREFERRED_WAIT;
+    } else {
+        hwp_increment(&s->fallback_entries);
+        fallback_wait(s, now);
+    }
+}
+hwp_action_t hwp_core_failed(hwp_core_t *s, uint64_t now) {
+    hwp_increment(&s->failures);
+    if (s->preferred) {
+        if (s->preferred_failures < 3) ++s->preferred_failures;
+        if (s->preferred_failures < 3 && now < s->preferred_deadline) {
+            s->phase = HWP_PREFERRED_WAIT;
+            s->next_at = now + 1000;
+            return HWP_DISCONNECT;
+        }
+        hwp_increment(&s->fallback_entries);
+    }
+    fallback_wait(s, now);
+    return HWP_DISCONNECT;
+}
+hwp_action_t hwp_core_step(hwp_core_t *s, uint64_t now, bool started,
+                           bool healthy, bool associated, uint64_t disconnect) {
+    if (!started) {
+        s->phase = HWP_STOPPED;
+        s->seen_disconnect = disconnect;
+        return HWP_NONE;
+    }
+    /* Driver/netif state wins over delayed event delivery. Never evict a
+     * healthy fallback connection, even after the preference cooldown. */
+    if (healthy) {
+        s->phase = HWP_ONLINE;
+        s->backoff = 0;
+        s->seen_disconnect = disconnect;
+        return HWP_NONE;
+    }
+    if (s->phase == HWP_STOPPED) {
+        cycle(s, now);
+    } else if (s->phase == HWP_ONLINE) {
+        if (associated) {
+            s->phase = s->preferred ? HWP_PREFERRED_CONNECTING : HWP_FALLBACK_CONNECTING;
+            /* Lost IP is bounded independently of a missing disconnect. */
+            s->deadline = now + HWP_CONNECT_MS;
+            s->preferred_deadline = s->deadline;
+        } else {
+            cycle(s, now);
+        }
+    }
+    if (s->phase == HWP_PREFERRED_CONNECTING || s->phase == HWP_FALLBACK_CONNECTING) {
+        bool disconnected = !associated && s->attempt_associated;
+        if (associated) s->attempt_associated = true;
+        s->seen_disconnect = disconnect;
+        if (disconnected || now >= s->deadline) return hwp_core_failed(s, now);
+    }
+    if (s->phase == HWP_PREFERRED_WAIT && now >= s->preferred_deadline) {
+        hwp_increment(&s->fallback_entries);
+        fallback_wait(s, now);
+        return HWP_DISCONNECT;
+    }
+    if ((s->phase == HWP_PREFERRED_WAIT || s->phase == HWP_FALLBACK_WAIT) && now >= s->next_at) {
+        s->seen_disconnect = disconnect;
+        s->attempt_associated = false;
+        s->phase = s->preferred ? HWP_PREFERRED_CONNECTING : HWP_FALLBACK_CONNECTING;
+        s->deadline = s->preferred ? s->preferred_deadline : now + HWP_CONNECT_MS;
