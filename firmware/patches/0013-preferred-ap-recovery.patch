+const char *hwp_phase_name(hwp_phase_t p) {
+    switch (p) {
+    case HWP_STOPPED: return "stopped";
+    case HWP_PREFERRED_WAIT: return "preferred_wait";
+    case HWP_PREFERRED_CONNECTING: return "preferred_connecting";
+    case HWP_FALLBACK_WAIT: return "fallback_wait";
+    case HWP_FALLBACK_CONNECTING: return "fallback_connecting";
+    case HWP_ONLINE: return "online";
+    default: return "unknown";
+    }
+}
+static int nibble(char c) {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+bool hwp_parse_mac(const char *text, uint8_t mac[6]) {
+    if (!text || strlen(text) != 17) return false;
+    uint8_t candidate[6]; unsigned nonzero = 0;
+    for (unsigned i = 0; i < 6; ++i) {
+        int a = nibble(text[i * 3]), b = nibble(text[i * 3 + 1]);
+        if (a < 0 || b < 0 || (i < 5 && text[i * 3 + 2] != ':')) return false;
+        candidate[i] = (uint8_t)((a << 4) | b); nonzero |= candidate[i];
+    }
+    if (!nonzero || (candidate[0] & 1)) return false;
+    memcpy(mac, candidate, 6);
+    return true;
+}
