# Verified receiver 2: ESP32-S3 rev 0.2, 16 MiB quad flash, 8 MiB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
# Wi-Fi TX DMA buffers must remain in internal RAM when PSRAM is enabled.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
# CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER is not set
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=16
CONFIG_WASM_ENABLE=y
CONFIG_WASM_VERIFY_SIGNATURE=y
CONFIG_WASM_MAX_MODULES=4
# CONFIG_DISPLAY_ENABLE is not set
CONFIG_EDGE_TIER=2
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_CSI_MOCK_ENABLED is not set

# Candidate mitigation for the pre-module Wi-Fi sniffer RX panic.
CONFIG_HOME_CSI_ASSOCIATED_ONLY=y
