+// These cross the later anomaly-baseline transition as well as gesture warmup.
+// Native tests exercise the paths; only a hardware trial establishes the 10 ms budget.
+#[cfg(test)]
+mod home_signal_warmup_tests {
+    use super::{adversarial::AnomalyDetector, coherence::CoherenceMonitor, gesture::GestureDetector};
+
+    #[test]
+    fn combined_flatline_path_runs_past_thousand_frames() {
+        let mut gesture = GestureDetector::new();
+        let mut coherence = CoherenceMonitor::new();
+        let mut anomaly = AnomalyDetector::new();
+        let mut mature_matches = 0;
+        for frame in 1..=1200 {
+            let phases = [0.25_f32; 32];
+            let amplitudes = [1.0_f32; 32];
+            if gesture.process_frame(&phases).is_some() && frame > 100 {
+                mature_matches += 1;
+            }
+            let score = coherence.process_frame(&phases);
+            assert!(score.is_finite() && (0.0..=1.000001).contains(&score));
+            let detected = anomaly.process_frame(&phases, &amplitudes);
+            assert_eq!(detected, frame > 100 && (frame - 101) % 20 == 0,
+                       "flatline transition/cooldown frame={frame}");
+        }
+        assert!(mature_matches > 0);
+        assert_eq!(anomaly.total_anomalies(), 55);
+    }
+
+    #[test]
+    fn combined_energy_spikes_after_baseline_keep_all_channels_finite() {
+        let mut gesture = GestureDetector::new();
+        let mut coherence = CoherenceMonitor::new();
+        let mut anomaly = AnomalyDetector::new();
+        for frame in 1..=1200 {
+            let spike = frame > 100 && frame % 100 == 1;
+            let mut phases = [0.0_f32; 32];
+            let mut amplitudes = [0.0_f32; 32];
+            for i in 0..32 {
+                phases[i] = frame as f32 * 0.001 + i as f32 * 0.01;
+                amplitudes[i] = (1.0 + i as f32 * 0.05) * if spike { 8.0 } else { 1.0 };
+            }
+            let _ = gesture.process_frame(&phases);
+            let score = coherence.process_frame(&phases);
+            assert!(score.is_finite() && (0.0..=1.000001).contains(&score));
+            assert_eq!(anomaly.process_frame(&phases, &amplitudes), spike,
+                       "post-baseline spike frame={frame}");
+        }
+        assert_eq!(anomaly.total_anomalies(), 11);
+    }
+}
