+// Deployment regression tests: these validate arithmetic and lifecycle behavior,
+// not gesture accuracy or ESP32 timing. The full matrix is a reference only.
+#[cfg(test)]
+mod bounded_dtw_tests {
+    use super::*;
+
+    fn reference(a: &[f32], b: &[f32]) -> f32 {
+        let (n, m) = (a.len(), b.len());
+        if n == 0 || m == 0 { return f32::MAX; }
+        let mut cost = [[f32::MAX; MAX_TEMPLATE_LEN]; MAX_WINDOW_LEN];
+        cost[0][0] = fabsf(a[0] - b[0]);
+        for i in 0..n {
+            for j in 0..m {
+                if i.abs_diff(j) > BAND_WIDTH { continue; }
+                let c = fabsf(a[i] - b[j]);
+                if i == 0 && j == 0 {
+                    cost[i][j] = c;
+                } else {
+                    let mut min_prev = f32::MAX;
+                    if i > 0 && cost[i - 1][j] < min_prev { min_prev = cost[i - 1][j]; }
+                    if j > 0 && cost[i][j - 1] < min_prev { min_prev = cost[i][j - 1]; }
+                    if i > 0 && j > 0 && cost[i - 1][j - 1] < min_prev { min_prev = cost[i - 1][j - 1]; }
+                    cost[i][j] = c + min_prev;
+                }
+            }
+        }
+        cost[n - 1][m - 1] / (n + m) as f32
+    }
+
+    #[test]
+    fn rolling_rows_match_full_matrix_bits_for_every_supported_length() {
+        for seed in 0..4_u32 {
+            let mut state = 0x9e3779b9_u32 ^ seed;
+            let mut a = [0.0_f32; MAX_WINDOW_LEN];
+            let mut b = [0.0_f32; MAX_TEMPLATE_LEN];
+            for value in a.iter_mut().chain(b.iter_mut()) {
+                state = state.wrapping_mul(1664525).wrapping_add(1013904223);
+                *value = match seed {
+                    0 => 0.0,
+                    1 => if state & 1 == 0 { -3.0 } else { 3.0 },
+                    2 => (state >> 16) as f32 / 8192.0 - 4.0,
+                    _ => if state & 1 == 0 { f32::MAX } else { -f32::MAX },
+                };
+            }
+            for n in 1..=MAX_WINDOW_LEN {
+                for m in 1..=MAX_TEMPLATE_LEN {
+                    assert_eq!(dtw_distance(&a[..n], &b[..m]).to_bits(),
+                               reference(&a[..n], &b[..m]).to_bits(),
+                               "seed={seed} n={n} m={m}");
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn band_endpoints_and_unreachable_sentinel_are_preserved() {
+        let data = [0.25_f32; MAX_WINDOW_LEN];
+        for (n, m) in [(13, 8), (8, 13), (14, 8), (8, 14), (60, 40)] {
+            assert_eq!(dtw_distance(&data[..n], &data[..m]).to_bits(),
+                       reference(&data[..n], &data[..m]).to_bits());
+        }
+        assert_eq!(dtw_distance(&data[..13], &data[..8]), 0.0);
+        assert!(dtw_distance(&data[..14], &data[..8]) > DTW_THRESHOLD);
+        assert_eq!(dtw_distance(&[], &data[..1]), f32::MAX);
+        assert_eq!(dtw_distance(&data[..1], &[]), f32::MAX);
+        assert_eq!(dtw_distance(&data, &data[..41]), f32::MAX);
+    }
+
+    #[test]
+    fn matching_remains_reachable_after_cooldown_and_ring_wrap() {
+        let mut detector = GestureDetector::new();
+        let mut previous_detection = None;
+        let mut late_detections = 0;
+        for frame in 1..=300 {
+            // A fixed low-cost synthetic fixture exercises reachability, not
+            // motion accuracy; upstream's threshold also accepts this signal.
+            if detector.process_frame(&[1.0]).is_some() {
+                if let Some(previous) = previous_detection {
+                    assert!(frame - previous >= 40, "cooldown changed");
+                }
+                if frame > MAX_WINDOW_LEN { late_detections += 1; }
+                previous_detection = Some(frame);
+            }
+        }
+        assert_eq!(detector.window_len, MAX_WINDOW_LEN);
+        assert!(late_detections >= 4, "mature windows must not disable matching");
+    }
+
+    #[test]
+    fn unmatched_mature_windows_keep_processing_without_cooldown() {
+        let mut detector = GestureDetector::new();
+        for frame in 0..500 {
+            assert!(detector.process_frame(&[frame as f32 * 64.0]).is_none());
+            assert_eq!(detector.cooldown, 0);
+        }
+        assert_eq!(detector.window_len, MAX_WINDOW_LEN);
+    }
