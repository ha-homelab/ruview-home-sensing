 /// Sakoe-Chiba band width (constrains warping path).
 const BAND_WIDTH: usize = 5;
+
+/// Four shared row credits include work on both sides of a template boundary.
+/// The shipped templates have lengths 12, 8, 8 and 10: at most 44 DP cells
+/// and 48 row-clear stores per callback. This is not a wall-time guarantee.
+const ROWS_PER_FRAME: usize = 4;
+const LONGEST_TEMPLATE: usize = 12;
+const SNAPSHOT_LEN: usize = LONGEST_TEMPLATE + BAND_WIDTH;
+
+struct DtwJob {
+    observation: [f32; SNAPSHOT_LEN],
