+        assert_eq!(LONGEST_TEMPLATE, det.templates.iter().map(|t| t.len).max().unwrap());
+        det.start_job();
+        let mut totals = (0, 0, 0);
+        let mut transitions_with_work = 0;
+        for call in 1..=15 {
+            let before = det.job.template;
+            let result = step(&mut det);
+            totals.0 += det.work.rows;
+            totals.1 += det.work.cells;
+            totals.2 += det.work.clears;
+            if det.job.template > before && det.job.row > 0 { transitions_with_work += 1; }
+            assert_eq!(det.job.active, call < 15);
+            assert_eq!(result.is_some(), call == 15);
+            if call < 15 { assert_eq!(det.work.rows, 4); }
