+
+    fn with_window(observation: &[f32]) -> GestureDetector {
+        let mut det = GestureDetector::new();
+        det.initialized = true;
+        det.window[..observation.len()].copy_from_slice(observation);
+        det.window_len = observation.len();
+        det.window_idx = observation.len() % MAX_WINDOW_LEN;
+        det
+    }
+
+    fn expected(det: &GestureDetector, observation: &[f32]) -> ([f32; 4], Option<u8>) {
+        let mut distances = [f32::MAX; NUM_TEMPLATES];
+        let mut best = DTW_THRESHOLD;
+        let mut id = None;
+        for (i, tmpl) in det.templates.iter().enumerate() {
+            if observation.len() < tmpl.len { continue; }
+            let start = observation.len().saturating_sub(tmpl.len + BAND_WIDTH);
+            let dist = dtw_distance(&observation[start..], &tmpl.values[..tmpl.len]);
+            distances[i] = dist;
+            if dist < best { best = dist; id = Some(tmpl.id); }
+        }
+        (distances, id)
+    }
+
+    fn step(det: &mut GestureDetector) -> Option<u8> {
+        det.work = WorkCount::default();
+        let result = det.advance_job();
+        assert!(det.work.rows <= 4);
+        assert!(det.work.cells <= 44);
+        assert!(det.work.clears <= 48);
+        result
+    }
+
+    #[test]
+    fn exact_v2_distances_and_matches_for_every_snapshot_length() {
+        let mut random = 0x9e3779b9_u32;
+        for seed in 0..16 {
+            for len in 1..=MAX_WINDOW_LEN {
+                let mut obs = [0.0; MAX_WINDOW_LEN];
+                for value in &mut obs[..len] {
+                    random = random.wrapping_mul(1664525).wrapping_add(1013904223);
+                    *value = match seed {
+                        0 => 0.0,
+                        1 => 64.0,
+                        2 => if random & 1 == 0 { f32::MAX } else { -f32::MAX },
+                        3 => if random & 1 == 0 { -0.0 } else { 0.0 },
+                        _ => (random >> 16) as f32 / 8192.0 - 4.0,
+                    };
+                }
+                let mut det = with_window(&obs[..len]);
+                let (distances, wanted) = expected(&det, &obs[..len]);
+                // Transition correctness cannot depend on zero-initialized rows.
+                det.job.rows = [[-123.0; MAX_TEMPLATE_LEN], [f32::NAN; MAX_TEMPLATE_LEN]];
+                det.start_job();
+                let mut result = None;
+                let mut calls = 0;
+                while det.job.active {
+                    result = step(&mut det);
+                    calls += 1;
+                    assert!(calls <= 15);
+                    if det.job.active { assert!(result.is_none()); }
+                }
+                for (got, want) in det.job.distances.iter().zip(distances) {
+                    assert_eq!(got.to_bits(), want.to_bits(), "seed={seed} len={len}");
+                }
+                assert_eq!(result, wanted, "seed={seed} len={len}");
+            }
+        }
+    }
