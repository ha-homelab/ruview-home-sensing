+    const fn new() -> Self {
+        Self {
+            observation: [0.0; SNAPSHOT_LEN],
+            len: 0,
+            active: false,
+            template: 0,
+            row: 0,
+            previous: 0,
+            // Row zero ignores the previous row. Each executed row clears
+            // its own active width, so no transition needs a full-array fill.
+            rows: [[0.0; MAX_TEMPLATE_LEN]; 2],
+            best_id: None,
+            best_dist: DTW_THRESHOLD,
+            #[cfg(test)]
+            distances: [f32::MAX; NUM_TEMPLATES],
+        }
+    }
+}
