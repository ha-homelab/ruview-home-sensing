+
+/// Maximum source-sample age accepted by the MQTT path. Receipt of a
+/// rebroadcast does not make its original observation fresh again.
+pub const SNAPSHOT_STALE_AFTER_MS: i64 = 10_000;
+
+/// Missing/invalid, future, expired and overflowing timestamps are unknown,
+/// not an empty-room observation. Keep this independent of transport clocks.
+pub fn snapshot_age_ms(timestamp_ms: i64, now_ms: i64) -> Option<u64> {
+    if timestamp_ms <= 0 {
+        return None;
+    }
+    let age = now_ms.checked_sub(timestamp_ms)?;
+    (0..SNAPSHOT_STALE_AFTER_MS).contains(&age).then_some(age as u64)
+}
+
+#[cfg(test)]
+mod freshness_tests {
+    use super::*;
+
+    #[test]
+    fn only_current_positive_timestamps_are_accepted() {
+        assert_eq!(snapshot_age_ms(20_000, 20_000), Some(0));
+        assert_eq!(snapshot_age_ms(10_001, 20_000), Some(9_999));
+        for ts in [0, -1, 10_000, 20_001, i64::MAX] {
+            assert_eq!(snapshot_age_ms(ts, 20_000), None, "{ts}");
+        }
+        assert_eq!(snapshot_age_ms(i64::MAX, i64::MIN), None);
+    }
+}
 
