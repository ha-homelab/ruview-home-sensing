+/// Source time is anchored to the monotonic availability clock. Repeated
+/// delivery of one observation cannot renew the node's last-seen instant.
+fn snapshot_seen_at(timestamp_ms: i64, now_ms: i64, now: Instant) -> Option<Instant> {
+    let age = super::state::snapshot_age_ms(timestamp_ms, now_ms)?;
+    now.checked_sub(Duration::from_millis(age))
+}
