+/// A successful enqueue is not a broker acknowledgement. Failed batches
+/// remain pending, so later maintenance retries them after the event loop
+/// drains its bounded request queue. Completed nodes do not starve retries.
+struct NodePublication {
+    builder: OwnedDiscoveryBuilder,
+    availability: NodeAvailability,
+    last_seen: Instant,
+    discovery_pending: bool,
+    availability_pending: bool,
+    announced_online: Option<bool>,
+}
+
+impl NodePublication {
+    fn queue_maintenance(
+        &mut self,
+        client: &AsyncClient,
+        entities: &[EntityKind],
+        heartbeat: bool,
+        refresh: bool,
+        now: Instant,
+    ) {
+        let online = now.saturating_duration_since(self.last_seen) < NODE_SNAPSHOT_STALE_AFTER;
+        if heartbeat || self.availability_pending || self.announced_online != Some(online) {
+            match publish_availability(client, &self.availability, if online { "online" } else { "offline" }) {
+                Ok(()) => {
+                    self.announced_online = Some(online);
+                    self.availability_pending = false;
+                }
+                Err(e) => {
+                    self.availability_pending = true;
+                    otel_warn!("[mqtt] availability enqueue failed; will retry: {e}");
+                }
+            }
+        }
+        if refresh || self.discovery_pending {
+            match publish_all_discovery(client, &self.builder.as_borrowed(), entities) {
+                Ok(()) => self.discovery_pending = false,
+                Err(e) => {
+                    self.discovery_pending = true;
+                    otel_warn!("[mqtt] discovery enqueue failed; will retry: {e}");
+                }
+            }
+        }
+    }
+}
