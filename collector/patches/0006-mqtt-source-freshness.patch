+/// Lag means some old frames were overwritten, not that the source ended.
+/// Continue from the broadcast receiver's next retained frame after lag.
+#[cfg(feature = "mqtt")]
+async fn mqtt_snapshot_bridge(
+    mut input: broadcast::Receiver<String>,
+    output: broadcast::Sender<wifi_densepose_sensing_server::mqtt::state::VitalsSnapshot>,
+    node_id: String,
+) {
+    loop {
+        let json = match input.recv().await {
+            Ok(json) => json,
+            Err(broadcast::error::RecvError::Lagged(_)) => continue,
+            Err(broadcast::error::RecvError::Closed) => break,
+        };
+        let Ok(value) = serde_json::from_str::<serde_json::Value>(&json) else {
+            continue;
+        };
+        for snapshot in fresh_vitals_snapshots_from_sensing_json(
+            &value, &node_id, chrono::Utc::now().timestamp_millis(),
+        ) {
+            let _ = output.send(snapshot);
+        }
+    }
+}
+
+/// Admit only fresh sensing observations to MQTT. Other broadcasts (WASM,
+/// fused events, etc.) must not become fabricated absent/zero snapshots.
+/// The public JSON stays unchanged; this gate is local to MQTT consumption.
+#[cfg(feature = "mqtt")]
+fn fresh_vitals_snapshots_from_sensing_json(
+    v: &serde_json::Value,
+    base_id: &str,
+    now_ms: i64,
+) -> Vec<wifi_densepose_sensing_server::mqtt::state::VitalsSnapshot> {
+    use wifi_densepose_sensing_server::mqtt::state::snapshot_age_ms;
+
+    let source = v["source"].as_str().unwrap_or("");
+    let timestamp = v["timestamp"].as_f64().unwrap_or(f64::NAN) * 1000.0;
+    if v["type"] != "sensing_update"
+        || source.is_empty()
+        || source.ends_with(":offline")
+        || matches!(source, "offline" | "unavailable" | "unknown")
+        || !timestamp.is_finite()
+        || timestamp <= 0.0
+        || timestamp >= i64::MAX as f64
+        || snapshot_age_ms(timestamp as i64, now_ms).is_none()
+        || v["classification"]["presence"].as_bool().is_none()
+        || v["classification"]["motion_level"] == "unavailable"
+    {
+        return Vec::new();
+    }
+
+    let snapshots = vitals_snapshots_from_sensing_json(v, base_id);
+    let Some(nodes) = v["nodes"].as_array().filter(|nodes| !nodes.is_empty()) else {
+        return snapshots;
+    };
+    snapshots.into_iter().zip(nodes).filter_map(|(mut snap, node)| {
+        // Synthetic/wifi NodeInfo may omit node_inference. An explicit
+        // per-node inference must carry fresh source age, including time
+        // spent in a rebroadcast, not merely a fresh envelope timestamp.
+        if let Some(inference) = node.get("node_inference").filter(|value| !value.is_null()) {
+            let classification = inference["classification"].as_str()?;
+            if matches!(classification, "unavailable" | "unknown" | "") {
+                return None;
+            }
+            let age = i64::try_from(inference["age_ms"].as_u64()?).ok()?;
+            snap.timestamp_ms = snap.timestamp_ms.checked_sub(age)?;
+            snapshot_age_ms(snap.timestamp_ms, now_ms)?;
+        }
+        Some(snap)
+    }).collect()
+}
