+        det.peak_max = 5.0;
+        det.peak_frames = MIN_PEAK_FRAMES;
+        det.peaks_in_window = u32::MAX;
+        det.process_frame(0.0, -1, -1, 0.1);
+        assert_eq!(det.peaks_in_window, u32::MAX);
+        assert!(det.state == PeakState::Watching);
+    }
