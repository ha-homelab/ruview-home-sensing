     #[test]
+    fn test_more_than_255_peaks_preserve_exact_cluster_count() {
+        let mut det = TailgateDetector::new();
+        for _ in 0..300 {
+            // Three real-shaped frames meet the native peak debounce.
+            for energy in [5.0, 5.0, 0.0] {
+                assert!(det.process_frame(energy, -1, -1, 0.1).is_empty());
+            }
+        }
+        assert_eq!(det.peaks_in_window, 300);
+        let mut events = Vec::new();
+        for _ in 0..TAILGATE_WINDOW {
+            events.extend_from_slice(det.process_frame(0.0, -1, -1, 0.1));
+        }
+        assert_eq!(events, vec![(EVENT_TAILGATE_DETECTED, 300.0), (EVENT_MULTI_PASSAGE, 300.0)]);
+    }
+
